# 門鈴的容器版。改造後 webhookd 通過「空機器測試」：它需要的宿主機接觸面只剩
#   讀一個密鑰檔（唯讀）＋寫一個信箱目錄，
# 沒有 glab、沒有 systemd、沒有任何憑證——這是 taskwire 裡容器買到真隔離的地方，
# 跟 task-ui 那顆「把宿主機能力一項項掛回去」的映像是兩回事。
#
# 程式編進映像而不是掛載：門鈴的職責已經凍結（收 HTTP、驗簽、投紙條），
# 映像不可變讓被打穿的容器連自己的程式都改不掉。2026-08-31 改寫成 Go 之後
# 更進一步：執行層是 scratch——沒有 shell、沒有套件管理、沒有任何其他檔案，
# 整顆映像就是一支靜態執行檔。改 cmd/task-webhookd 之後要重 build 再 restart。
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd/task-webhookd cmd/task-webhookd
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /task-webhookd ./cmd/task-webhookd

FROM scratch
COPY --from=build /task-webhookd /usr/local/bin/task-webhookd
# 密鑰與信箱的路徑都從 $HOME 推，跟宿主機對齊（quadlet 用 keep-id 同 uid 同路徑）。
ENV HOME=/home/miskawu
EXPOSE 9587
ENTRYPOINT ["/usr/local/bin/task-webhookd"]
