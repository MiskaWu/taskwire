#!/usr/bin/env bash
# task-dispatch —— 無頭取件器。門鈴信箱（task-doorbell.path）與對帳 timer 都以
# task-dispatch.service 拉起這裡；task-ui 的手動叫醒直接執行本檔。
#
# 一次處理一張單：task next 取件 → 起無頭 claude 照協定做 → 機械兜底。
# 兩層寫回（設計文件「C 檔施工規格」）：
#   協定層：提示告訴模型——做完 task done、卡住 task block，沒有人會回你。
#   兜底層：claude 退出後檢查單子最終狀態，還停在 doing 就補 block。
#     不管模型行為如何，單子永遠不會停在「看起來有人在做、其實沒人在做」。
#
# 冪等與防遞迴：
#   - flock -n：忙碌中再被門鈴叫醒就直接退出。無頭會話自己動標籤會再觸發
#     webhook → 新的 dispatch → 被這把鎖擋掉，不會滾雪球。
#   - 做完一張後不主動連做：done 的標籤變更會再響一次門鈴，自然接力下一張。
#   - TASK_HEADLESS=1 傳進 claude，讓 hook 鏈知道自己在無頭情境。
#
# 權限：無頭 claude 讀同一份 settings.json（auto mode 照常）。沙箱外的動作
# 在互動時是問人，這裡是自動拒絕——模型收到拒絕訊息後照協定 block。
# 刻意不用 --dangerously-skip-permissions：不在沒人看著的時候拆最後把關。

set -euo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

# 設定的單一真相來源：~/.config/taskwire/config.env（見 taskwire-config.sh）。
# readlink -f 不能省——這支腳本是 symlink 進 ~/.local/bin/ 的。
_TW_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=taskwire-config.sh
[ -f "$_TW_DIR/taskwire-config.sh" ] && . "$_TW_DIR/taskwire-config.sh"

STATE_DIR="$HOME/.local/state/taskwire"
LOCK="$STATE_DIR/dispatch.lock"
TIMEOUT="${TASK_DISPATCH_TIMEOUT:-3600}"   # 秒。防「做錯方向做一整夜」。
# 兜底那段要用同一個倉庫路徑；以前這裡是寫死的字面值，改設定就會兩邊分岔。
REPO="${TASK_REPO:-gitlab.dev.baasgames.com/hydrogen/roles/engineer/miskawu/docs/backlogs}"
mkdir -p "$STATE_DIR"

# 收信箱：把門鈴紙條清掉。必須在搶鎖「之前」——搶輸的那次也要把紙條收走,
# 否則 task-doorbell.path 看到信箱非空，會在本次退出後立刻再觸發，空轉。
# 紙條不含資訊（門鈴只有一個位元），收走不會漏事——真實狀態由 task next 重讀。
DOORBELL_DIR="$STATE_DIR/doorbell"
mkdir -p "$DOORBELL_DIR"
rm -f "$DOORBELL_DIR"/ring-* 2>/dev/null || true

exec 9>"$LOCK"
flock -n 9 || { echo "dispatch 已在跑，跳過（$(date '+%F %T')）"; exit 0; }

echo "=== dispatch $(date '+%F %T') ==="

# 取件。task next 失敗（API 掛了）會大聲退出非零——這裡不吞，讓 log 留紀錄。
next_out=$(task next)
echo "$next_out"
iid=$(grep -oE '#[0-9]+' <<< "$next_out" | head -1 | tr -d '#') || true
[ -n "${iid:-}" ] || { echo "沒有可接的單，收工。"; exit 0; }

run_log="$STATE_DIR/run-$(date +%Y%m%d-%H%M%S)-$iid.log"
echo "處理 #$iid，claude log → $run_log"

# 憑證預檢（2-2A，保守版）：accessToken 過期是常態（refresh 會救），不能當失效訊號；
# 只有「憑證檔不存在」或「到期時間已落後超過 48 小時」（代表很久沒有成功 refresh）
# 才提早示警。示警不擋工——refresh 仍可能成功，真失敗由事後判定接手。
_notify_auth() {
  local stamp="$STATE_DIR/auth-notify.stamp"
  # 6 小時內不重複吵（timer 每小時都會跑到這裡）
  if [ -f "$stamp" ] && [ -n "$(find "$stamp" -mmin -360 2>/dev/null)" ]; then return 0; fi
  task-notify "$1" || true
  touch "$stamp"
}
creds="$HOME/.claude/.credentials.json"
if [ ! -f "$creds" ]; then
  _notify_auth "無頭取件預檢：找不到 CLI 憑證檔（$creds）。修復：終端機跑 claude /login"
else
  exp_ms=$(jq -r '[.. | .expiresAt? | select(. != null)] | first // empty' "$creds" 2>/dev/null || true)
  if [ -n "$exp_ms" ] && [ "$(( $(date +%s) - exp_ms / 1000 ))" -gt 172800 ]; then
    _notify_auth "無頭取件預檢：CLI 憑證已 48 小時以上沒有成功刷新，可能失效。修復：終端機跑 claude /login"
  fi
fi

# —— 工作區（workspace:: 標籤 → worktree）。拍板 2026-08-28：標籤是機械指標。
# workspace::<相對 ~/projects 路徑> 指到 git repo 就機械開（或重用）worktree 站進去；
# 指到多 repo 工作區目錄（本身不是 git repo，例：hydrogen）就站到目錄，
# 內部要動哪個 repo 交給模型，但 worktree 位置定成慣例讓 GC 巡得到。
# 沒標籤＝交給模型判斷（拍板：判斷放模型）；標籤指到不存在的路徑是壞指標，block。
vj=$(glab issue view "$iid" -R "$REPO" --output json 2>&1) || {
  echo "讀單失敗，退出：$vj"; exit 1; }
repo_rel=$(jq -r '[.labels[]? | select(startswith("workspace::"))][0] // empty' <<< "$vj")
repo_rel=${repo_rel#workspace::}
# 基準有兩形：base::<分支>（單 repo）與 base::<repo名>::<分支>（多 repo 工作區，
# 逐 repo 一顆）。這裡各取各的，互不誤抓。
base_br=$(jq -r '[.labels[]? | select(test("^base::[^:]+$"))][0] // empty' <<< "$vj")
base_br=${base_br#base::}
base_map=$(jq -r '[.labels[]? | select(test("^base::[^:]+::[^:]+$")) | sub("^base::";"") | sub("::";" → ")] | join("、")' <<< "$vj")
# mode:: 執行方式旋鈕（2026-08-28 拍板）：不貼＝worktree 流程（安全預設）；
# read＝調查單只讀；direct＝直接修主 checkout（放寬安全，所以配機械守門：髒就 block）。
op_mode=$(jq -r '[.labels[]? | select(startswith("mode::"))][0] // empty' <<< "$vj")
op_mode=${op_mode#mode::}
case "$op_mode" in
  ""|read|direct) : ;;
  *) task block "$iid" "不認識的 mode::$op_mode（只有 read／direct，拿掉標籤＝預設 worktree 流程）。請重標：task mode $iid <direct|read|off>。"
     exit 0 ;;
esac

WT_ROOT="$STATE_DIR/worktrees"
ws_hint=""
if [ -n "$repo_rel" ]; then
  src="$HOME/projects/$repo_rel"
  if [ -d "$src/.git" ] && [ "$op_mode" = "read" ]; then
    # 調查單：不開 worktree，站主 checkout 只讀。
    cd "$src"
    ws_hint="這是調查單（mode::read）：你站在 ~/projects/$repo_rel 的主 checkout，只讀不改檔——不開 worktree、不 commit。交件是把調查結論寫回單上（task note／task done 的留言）。"
  elif [ -d "$src/.git" ] && [ "$op_mode" = "direct" ]; then
    # 直接修主 checkout。機械守門：主 checkout 不乾淨就 block——
    # 使用者未 commit 的工作和代理的改動混在一起是不可逆傷害，這條不放。
    if [ -n "$(git -C "$src" status --porcelain 2>/dev/null)" ]; then
      task block "$iid" "mode::direct 但 ~/projects/$repo_rel 的主 checkout 有未 commit 的改動——不敢進場，怕跟你手上的工作混在一起。清乾淨再觸發，或改走 worktree（task mode $iid off）。"
      exit 0
    fi
    cd "$src"
    ws_hint="直接修模式（mode::direct）：你站在 ~/projects/$repo_rel 的主 checkout（進場前已確認乾淨），直接在目前分支上修，完成要 commit；不開 worktree、不推 origin。"
  elif [ -d "$src/.git" ]; then
    mkdir -p "$WT_ROOT"
    wt="$WT_ROOT/$iid"
    if [ ! -d "$wt" ]; then
      git -C "$src" fetch --quiet 2>/dev/null || echo "fetch 失敗，改用本地基準"
      if git -C "$src" rev-parse --verify -q "refs/heads/task/$iid" >/dev/null; then
        # 分支還在（上次 worktree 被清但分支保留）：接回同一條分支
        wt_out=$(git -C "$src" worktree add "$wt" "task/$iid" 2>&1) \
          || { task block "$iid" "重開 worktree 失敗：$wt_out"; exit 0; }
      else
        base_ref=""
        if [ -n "$base_br" ]; then
          for cand in "origin/$base_br" "$base_br"; do
            git -C "$src" rev-parse --verify -q "$cand" >/dev/null && { base_ref="$cand"; break; } || true
          done
          [ -n "$base_ref" ] || { task block "$iid" "base::$base_br 在 ~/projects/$repo_rel 找不到（本地與 origin 都沒有）。請重標：task ws $iid $repo_rel <分支>。"; exit 0; }
        else
          base_ref=$(git -C "$src" symbolic-ref -q --short refs/remotes/origin/HEAD || true)
          [ -n "$base_ref" ] || base_ref=$(git -C "$src" symbolic-ref -q --short HEAD)
        fi
        wt_out=$(git -C "$src" worktree add "$wt" -b "task/$iid" "$base_ref" 2>&1) \
          || { task block "$iid" "開 worktree 失敗：$wt_out"; exit 0; }
        echo "worktree 開好：$wt（基準 $base_ref）"
      fi
    else
      echo "worktree 重用：$wt"
    fi
    cd "$wt"
    ws_hint="工作區已備好——你現在就站在這張單的 worktree（分支 task/$iid，源 repo ~/projects/$repo_rel${base_br:+，基準 $base_br}）。改動就在這裡做，完成要 commit；不推 origin（push guard 會擋，這是設計不是障礙）。"
  elif [ -d "$src" ]; then
    # 多 repo 工作區模式：站到目錄即可，內部判斷交給模型，但 worktree 位置是慣例。
    cd "$src"
    case "$op_mode" in
      read)
        ws_hint="這是調查單（mode::read）：你站在多 repo 工作區 ~/projects/$repo_rel，只讀不改檔——不開 worktree、不 commit。交件是把調查結論寫回單上（task note／task done 的留言）。" ;;
      direct)
        # 多 repo 下守門守不了（不知道會動哪個 repo），乾淨檢查交給模型執行。
        ws_hint="直接修模式（mode::direct）：你站在多 repo 工作區 ~/projects/$repo_rel，要動哪些內部 repo 由你判斷，直接修該 repo 的主 checkout——但動手前先確認該 repo 乾淨（git status），髒就 task block 不要碰；完成在目前分支 commit、不推 origin。" ;;
      *)
        ws_hint="工作區是 ~/projects/$repo_rel——這是多 repo 的工作區目錄（本身不是 git repo），你已站在這裡。要動哪些內部 repo 由你依單上內容判斷。程式改動不要直接改各 repo 的主 checkout：在該 repo 開 worktree，位置固定 $WT_ROOT/$iid-<repo名>、分支 task/$iid，完成要 commit、不推 origin。位置慣例是 GC 對帳用的，別放別處。基準分支：${base_map:+單上指定了 $base_map；}沒指定的 repo 先 fetch、從它的遠端預設主線長出來。" ;;
    esac
  else
    task block "$iid" "工作區標籤 workspace::$repo_rel 指到的 ~/projects/$repo_rel 不存在。請重標：task ws $iid <路徑>。"
    exit 0
  fi
else
  case "$op_mode" in
    read)
      ws_hint="這張單沒有標工作區（workspace:: 標籤），但標了 mode::read：調查單，只讀不改檔，該看哪裡由你判斷；交件是把結論寫回單上。判斷不出來就 task block 請使用者跑 task ws $iid <路徑>。" ;;
    direct)
      ws_hint="這張單沒有標工作區（workspace:: 標籤），但標了 mode::direct：落在哪個 repo 由你判斷，直接修主 checkout——動手前先確認該 repo 乾淨（git status），髒就 task block 不要碰；完成 commit、不推 origin。判斷不出來就 task block 請使用者跑 task ws $iid <路徑>。" ;;
    *)
      ws_hint="這張單沒有標工作區（workspace:: 標籤）。由你判斷工作落在哪個 repo：cd 過去做，程式改動開 worktree、完成要 commit、不推 origin。判斷不出來就 task block 請使用者跑 task ws $iid <路徑> 標好工作區再觸發。" ;;
  esac
fi

prompt=$(cat <<PROMPT
你在無頭會話（webhook 觸發的 backlog 取件），沒有人會回你的問題。
目標：處理 backlog 單 #$iid（task 指令已在 PATH，倉庫是內部 GitLab 的 docs/backlogs）。

協定，依序執行：
1. task show $iid 讀單，理解 why、現況、驗收條件。
2. task start $iid "開工摘要" 接手。驗收條件由你判斷：單上有就照它；
   沒有就依需求自己擬一份可檢查的，先 task note 留在單上再動工；
   需求模糊到你擬不出可檢查的條件，就 task block 問。
3. 動手做。$ws_hint
4. 任何沒把握的點——驗收看不懂、要做設計取捨、權限被拒又繞不開——
   不要猜：task block $iid "卡在哪＋你的建議"，然後結束。
5. 做完且依驗收條件自檢通過：task done $iid "交件摘要＋你怎麼驗的"。
6. 邊界：不關單、不動其他單的狀態、不碰 todo 的拉入。
PROMPT
)

rc=0
TASK_HEADLESS=1 timeout "$TIMEOUT" \
  claude -p "$prompt" >"$run_log" 2>&1 || rc=$?
echo "claude 退出 rc=$rc"

# 事後判定（2-2B）：起了才發現憑證死了——這是最可靠的訊號
if grep -qiE "Failed to authenticate|OAuth" "$run_log"; then
  _notify_auth "無頭取件起不來：CLI 憑證失效（#$iid，log：$run_log）。修復：終端機跑 claude /login，之後把單重新觸發即可"
fi

# 機械兜底：模型沒機會寫回的死法（timeout=124、斷線、被殺）都落到這裡。
labels=$(glab issue view "$iid" -R "$REPO" \
           --output json 2>/dev/null | jq -r '[.labels[]?] | join(" ")' || echo "")
case " $labels " in
  *" doing "*)
    echo "兜底：#$iid 停在 doing，補 block。"
    task block "$iid" "無頭會話異常結束（exit=$rc），沒能自行交件或報卡。log：$run_log，需要人看。" \
      || echo "兜底 block 也失敗了——API 可能整個不通，留給 log。"
    ;;
  *)
    echo "#$iid 最終狀態：${labels:-（無標籤）}，不需兜底。"
    ;;
esac
# 對帳回收：關單後的 worktree 由 GC 依安全判準清掉（詳見 task-gc 檔頭）。
"$_TW_DIR/task-gc" || echo "GC 沒跑完（見上方輸出），不影響本次取件。"
echo "=== dispatch 結束 $(date '+%F %T')（exit=$rc）==="
