#!/usr/bin/env bash
# task-digest —— 每日巡檢助手（2026-08-28 拍板）。
#
# 定位：**檢查不吃對話的 context**。要看的全是結構化資料（球在誰手上、停多久、
# token 剩幾天、服務活著沒），純 bash 組日報，零 LLM token、行為機械。
# 走 task-notify -d 推 Discord；日報天天發——它同時是巡檢自己的心跳，
# 靜默的巡檢壞掉時沒有人會發現。
#
# 之後所有「定期幫我們檢查」的項目都加在這裡搭便車（token 到期＝#32、
# 服務健康、久停的單），不另開排程。
#
# 排程：systemd/task-digest.timer（預設每天 09:00，Persistent=true）。

set -uo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

REPO="${TASK_REPO:-gitlab.dev.baasgames.com/hydrogen/roles/engineer/miskawu/docs/backlogs}"
HOST="${REPO%%/*}"

now=$(date +%s)

# —— 撈一次全量，本地切分（與 task 同款）——
all=$(glab issue list -R "$REPO" --output json -P 100 2>&1) || {
  task-notify -t 異常 "日報巡檢失敗：glab 連不上（$(head -c 200 <<< "$all")）。跑 task doctor 檢查。"
  exit 1
}

# 每列附「停了幾天」（以 updated_at 起算）
_rows() { # $1=label
  jq -r --arg l "$1" --argjson now "$now" '
    [.[] | select(.labels | index($l))][] |
    "#\(.iid) \(.title)（\(( ($now - (.updated_at | sub("\\.[0-9]+";"") | fromdate)) / 86400 | floor ))天）"
  ' <<< "$all"
}
_count() { jq --arg l "$1" '[.[] | select(.labels | index($l))] | length' <<< "$all"; }

done_rows=$(_rows done);    done_n=$(_count done)
blk_rows=$(_rows blocked);  blk_n=$(_count blocked)
doing_n=$(_count doing); todo_n=$(_count todo)
inbox_n=$(jq '[.[] | select([.labels[]? | select(. == "todo" or . == "doing"
             or . == "blocked" or . == "done")] | length == 0)] | length' <<< "$all")
# doing 停超過兩天：兜底理論上不會讓它發生，發生就值得看一眼
stale_doing=$(jq -r --argjson now "$now" '
  [.[] | select(.labels | index("doing"))
       | select(($now - (.updated_at | sub("\\.[0-9]+";"") | fromdate)) > 172800)][] |
  "#\(.iid) \(.title)"' <<< "$all")

# —— 系統健康 ——
creds="$HOME/.claude/.credentials.json"; cred_line="無頭憑證 OK"
if [ ! -f "$creds" ]; then cred_line="無頭憑證 ⚠ 檔案不存在（claude /login）"
else
  exp_ms=$(jq -r '[.. | .expiresAt? | select(. != null)] | first // empty' "$creds" 2>/dev/null || true)
  [ -n "$exp_ms" ] && [ "$(( now - exp_ms / 1000 ))" -gt 172800 ] \
    && cred_line="無頭憑證 ⚠ 逾 48h 未刷新（claude /login）"
fi
tok_line="glab token ?"
exp=$(glab api personal_access_tokens/self --hostname "$HOST" 2>/dev/null | jq -r '.expires_at // empty')
if [ -n "$exp" ]; then
  left=$(( ( $(date -d "$exp" +%s) - now ) / 86400 ))
  tok_line="glab token 剩 ${left} 天"; [ "$left" -lt 30 ] && tok_line="$tok_line ⚠ 該換發（#32）"
fi
hook_line="webhook active"
systemctl --user is-active task-webhook.service >/dev/null 2>&1 || hook_line="webhook ⚠ 不在跑"

# —— 組報文 ——
msg="📋 日報 $(date '+%m/%d')
球在你手上："
if [ -n "$done_rows$blk_rows" ]; then
  [ -n "$done_rows" ] && msg="$msg
待驗收：
$done_rows"
  [ -n "$blk_rows" ] && msg="$msg
等你回話：
$blk_rows"
else
  msg="$msg 乾淨，沒有等你的。"
fi
msg="$msg
在途：doing $doing_n｜todo $todo_n｜收集 $inbox_n"
[ -n "$stale_doing" ] && msg="$msg
⚠ doing 停超過 2 天（不該發生，看一眼）：
$stale_doing"
msg="$msg
系統：$cred_line｜$tok_line｜$hook_line"

echo "$msg"
task-notify -d -t 日報 "$msg" || true
